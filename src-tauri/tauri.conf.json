{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-recorder",
  "version": "0.1.0",
  "identifier": "com.aidankmcalister.screen-recorder",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "bar",
        "title": "screen-recorder",
        "width": 1000,
        "height": 58,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "preview",
        "title": "Recording preview",
        "width": 360,
        "height": 225,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "editor",
        "title": "screen-recorder",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "theme": "Dark",
        "backgroundColor": "#0e0e10",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "screen-recorder dev"
    },
    "copyright": "Copyright © 2026 Aidan McAlister. MIT License.",
    "category": "Video",
    "shortDescription": "A small, free, open-source screen recorder for macOS."
  }
}
