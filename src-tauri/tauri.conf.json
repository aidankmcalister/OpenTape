{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTape",
  "version": "0.1.0",
  "identifier": "com.aidankmcalister.opentape",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run notices && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "bar",
        "title": "OpenTape",
        "width": 1000,
        "height": 58,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "preview",
        "title": "Recording preview",
        "width": 360,
        "height": 225,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "editor",
        "title": "OpenTape",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 27 },
        "theme": "Dark",
        "backgroundColor": "#0e0e10",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQUQzQTkwNjNFRUNGRUIKUldUcnorNWprRHF0MnBJbmo1Q0hueGsycCtxWGJlQ1pwYytzZ3FZSXRCUndZb2gxYlhqUktiZTEK",
      "endpoints": [
        "https://github.com/aidankmcalister/OpenTape/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "screen-recorder dev",
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./icons/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 170, "y": 208 },
        "applicationFolderPosition": { "x": 490, "y": 208 }
      }
    },
    "copyright": "Copyright © 2026 Aidan McAlister. MIT License.",
    "category": "Video",
    "resources": ["THIRD-PARTY-NOTICES.txt"],
    "shortDescription": "A small, free, open-source screen recorder for macOS.",
    "longDescription": "Record a display, a window or an area of your Mac with the microphone and system audio. Save the clip as it is, or open it in a simple editor to add zooms, a smoothed cursor, a background and cuts, then export an MP4 or GIF."
  }
}
